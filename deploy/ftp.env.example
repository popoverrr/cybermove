# Скопировать в deploy/ftp.env (файл в .gitignore, в репозиторий не попадает) и заполнить.
# Значения из Plesk → Websites & Domains → cybermove.asia → FTP Access.
FTP_HOST=cybermove.asia
FTP_USER=cybermove
FTP_PASS=
# Папка сайта относительно корня FTP-аккаунта. Для аккаунта с домашней папкой /cybermove.asia это /httpdocs.
# Если оставить пустым — скрипт сам найдёт httpdocs.
FTP_REMOTE_DIR=/httpdocs
SITE_URL=https://cybermove.asia
