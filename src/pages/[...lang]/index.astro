---
/** Главная: 8 экранов со сквозной 3D-сценой (BRIEF §7). */
import Base from '../../layouts/Base.astro';
import S1Core from '../../components/home/S1Core.astro';
import ScreenServices from '../../components/home/ScreenServices.astro';
import S7Growth from '../../components/home/S7Growth.astro';
import S8Contact from '../../components/home/S8Contact.astro';
import HomeAbout from '../../components/home/HomeAbout.astro';
import Drawer from '../../components/home/Drawer.astro';
import Rail from '../../components/home/Rail.astro';
import Overlays from '../../components/home/Overlays.astro';
import Hints from '../../components/home/Hints.astro';
import { getContent, langStaticPaths, localePath } from '../../lib/i18n';
import '../../styles/home.css';

export function getStaticPaths() {
  return langStaticPaths();
}

const { lang } = Astro.props;
const c = getContent(lang);
const s1 = c.home.s1;
---

<Base lang={lang} path="/" title={c.ui.meta.home.title} description={c.ui.meta.home.description} theme="ivory" bodyClass="is-home" noFooter>
  <div class="gl-wrap" aria-hidden="true">
    <div class="gl-poster" data-poster></div>
    <canvas id="gl" class="gl-canvas"></canvas>
  </div>

  <!-- подписи-анкоры (BRIEF-3 §4): моношрифт, выноска 24px, привязаны к 3D-точкам через state.anchors -->
  <div class="anchor-labels" aria-hidden="true">
    {s1.orbits.map((label, i) => (
      <span class="anchor t-micro" data-anchor={`orbit-${i}`} data-orbit-link={i + 1}><span class="anchor__tick"></span>{label}</span>
    ))}
    {c.services.directions[0].dataPoints.map((label, i) => (
      <span class="anchor t-micro" data-anchor={`dp-${i}`}><span class="anchor__tick"></span>{label}</span>
    ))}
    {c.services.directions[1].micro.map((label, i) => (
      <span class="anchor t-micro" data-anchor={`node-${i}`}><span class="anchor__tick"></span>{label}</span>
    ))}
    <span class="anchor t-micro" data-anchor="figure"><span class="anchor__tick"></span>{c.services.directions[2].micro.map((label, i) => <span data-figure={i}>{label}</span>)}</span>
    {c.services.directions[3].services.map((s) => (
      <span class="anchor t-micro" data-anchor={`metric-${s.id}`}><span class="anchor__tick"></span>{s.metric}</span>
    ))}
    {c.services.directions[4].micro.map((label, i) => (
      <span class="anchor t-micro" data-anchor={`sheet-${i}`}><span class="anchor__tick"></span>{label}</span>
    ))}
    {c.home.s7.counters.slice(0, 3).map((k, i) => (
      <span class="anchor t-micro" data-anchor={`ring-${i}`}><span class="anchor__tick"></span>{k.value}{k.suffix} {k.label}</span>
    ))}
  </div>

  <!-- анкоры S8: отдельный слой, клипируется прямоугольником секции #contact (BRIEF-4 §1.3) -->
  <div class="anchor-labels anchor-labels--contact" data-anchor-layer="contact" aria-hidden="true">
    {c.contact.form.formatOptions.slice(0, 3).map((f, i) => (
      <span class="anchor t-micro" data-anchor={`contact-${i}`}><span class="anchor__tick"></span>{f.label}</span>
    ))}
  </div>

  <!-- технический слой (BRIEF-3 §8.5): «координаты» состояния сцены -->
  <p class="status t-micro" data-status aria-hidden="true"></p>

  <div class="stage-wrap" data-stage-wrap>
    <div class="stage" data-stage>
      <S1Core lang={lang} />

      {c.services.directions.map((d, i) => (
        <ScreenServices lang={lang} direction={d} index={i + 1} />
      ))}
      <S7Growth lang={lang} />
    </div>
  </div>

  <!--
    BRIEF-SEO §3: без JavaScript стейдж не анимируется — экраны S2–S7 встают в поток статично,
    строки услуг (кнопки drawer) дублируются ссылками на страницы услуг, CTA ведёт на /contact/.
  -->
  <noscript>
    <style is:inline>
      .stage-wrap { height: auto !important; }
      .stage { position: relative !important; height: auto !important; overflow: visible !important; contain: none !important; }
      .stage .screen { position: relative !important; inset: auto !important; visibility: visible !important; pointer-events: auto !important; }
      .stage .screen__pin { height: auto !important; padding-bottom: var(--space-16); }
      .stage .rows, .anchor-labels, .status, .rail, .preloader { display: none !important; }
      .nojs { position: relative; z-index: 1; background: var(--bg); border-top: 1px solid var(--hair); }
      .nojs__inner { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-8); padding-top: var(--space-16); padding-bottom: var(--space-16); max-width: none; }
      .nojs__dir { display: grid; gap: var(--space-2); align-content: start; }
      .nojs__dir > a { font-size: var(--fs-h4); }
      .nojs__dir li a { color: var(--fg-2); font-size: var(--fs-small); }
      .nojs__cta { grid-column: 1 / -1; }
    </style>
    <nav class="nojs" aria-label={c.ui.services}>
      <div class="container nojs__inner">
        {c.services.directions.map((d) => (
          <div class="nojs__dir">
            <p class="t-micro">{d.index} · {d.stage}</p>
            <a href={localePath(lang, `/services/${d.slug}/`)}>{d.nameFull}</a>
            <ul>
              {d.services.map((sv) => (
                <li><a href={localePath(lang, `/services/${d.slug}/${sv.id}/`)}>{sv.name}</a></li>
              ))}
            </ul>
          </div>
        ))}
        <p class="nojs__cta"><a class="t-h4" href={localePath(lang, '/contact/')}>{c.ui.cta} →</a></p>
      </div>
    </nav>
  </noscript>

  <HomeAbout lang={lang} />
  <S8Contact lang={lang} />

  <Rail lang={lang} />
  <Overlays lang={lang} />
  <Hints lang={lang} />
  <Drawer lang={lang} />

  <script>
    import { initHome } from '../../lib/home';
    initHome();
  </script>
</Base>

<style>
  .stub {
    height: 100%;
    display: grid;
    align-content: center;
    gap: var(--space-4);
    max-width: 900px;
    margin-inline: 0;
    padding-top: var(--header-h);
  }
</style>
