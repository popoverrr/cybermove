---
/**
 * /services/<направление>/<услуга>/ — страница услуги (BRIEF-SEO §1): крошки, H1 под основной запрос, лид,
 * «Что входит», «Как проходит работа» (CHAOS → CORE → SYSTEM → GROWTH), «Результат», «Кому подходит»,
 * связанные кейсы, FAQ (FAQPage), соседние услуги и CTA с ?service=<id>. Тексты — services.json → seo.
 */
import Base from '../../../../layouts/Base.astro';
import PageHero from '../../../../components/PageHero.astro';
import CtaBlock from '../../../../components/CtaBlock.astro';
import Button from '../../../../components/Button.astro';
import CaseTile from '../../../../components/CaseTile.astro';
import { getContent, localePath, findCase, type LangCode } from '../../../../lib/i18n';
import { LANGS } from '../../../../../site.config';
import { breadcrumbLd, serviceItemLd, faqLd } from '../../../../lib/seo';
import InsightCard from '../../../../components/InsightCard.astro';
import { getInsights } from '../../../../lib/insights';

export function getStaticPaths() {
  const out: Array<{
    params: { lang: string | undefined; direction: string; service: string };
    props: { lang: LangCode; dirId: string; serviceId: string };
  }> = [];
  for (const l of LANGS) {
    const c = getContent(l.code);
    for (const d of c.services.directions) {
      for (const s of d.services) {
        out.push({
          params: { lang: l.prefix || undefined, direction: d.slug, service: s.id },
          props: { lang: l.code, dirId: d.id, serviceId: s.id },
        });
      }
    }
  }
  return out;
}

const { lang, dirId, serviceId } = Astro.props;
const c = getContent(lang);
const d = c.services.directions.find((x) => x.id === dirId)!;
const s = d.services.find((x) => x.id === serviceId)!;
const seo = s.seo;
const dirPath = `/services/${d.slug}/`;
const path = `${dirPath}${s.id}/`;
const siblings = d.services.filter((x) => x.id !== s.id);
// пояснение направления аудита («финансовый аудит» — не обязательный аудит, «инвестиции» — не ценные бумаги) — только там, где оно о предмете
const showNote = Boolean(d.note) && ['financial-audit', 'investment'].includes(s.id);
const cases = seo.cases.map((id) => findCase(c, id)).filter((k): k is NonNullable<typeof k> => Boolean(k));

const crumbs = [
  { name: c.ui.home, path: '/' },
  { name: c.ui.services, path: '/services/' },
  { name: d.name, path: dirPath },
  { name: s.name, path },
];
const jsonLd = [
  breadcrumbLd(lang, crumbs),
  serviceItemLd(lang, { name: seo.h1, serviceType: s.name, description: seo.description, path, category: d.nameFull }),
  faqLd(seo.faq),
];
// BRIEF-SEO §2: 1–2 разбора, где услуга указана в services[] статьи
const articles = (await getInsights(lang)).filter((x) => x.entry.data.services.includes(s.id)).slice(0, 2);
const pad = (n: number) => String(n).padStart(2, '0');
let n = 0;
const num = () => pad(++n);
---

<Base lang={lang} path={path} title={seo.title} description={seo.description} theme={d.theme as never} jsonLd={jsonLd}>
  <PageHero
    theme={d.theme as never}
    label={`${d.index} · ${d.name}`}
    title={seo.h1}
    lead={seo.lead}
    micro={d.micro}
    photo={`dir-${d.id}`}
    beam={d.id === 'brand-content' ? 0.6 : 0}
    size="md"
    wide
    crumbs={crumbs.map((x) => ({ name: x.name, href: localePath(lang, x.path) }))}
    ariaCrumbs={c.ui.crumbs}
  />

  <section class="sp sp--intro">
    <div class="container sp__intro">
      <p class="sp__introText">{seo.intro}</p>
      {showNote && <p class="t-small sp__note">{d.note}</p>}
    </div>
  </section>

  <section class="sp" aria-labelledby="sp-includes">
    <div class="container sp__inner">
      <header class="sp__head">
        <p class="t-micro sp__idx">{num()}</p>
        <h2 class="t-h3" id="sp-includes">{c.ui.included}</h2>
      </header>
      <ul class="sp__grid">
        {seo.includes.map((x) => (
          <li class="sp__card">
            <h3 class="t-h4">{x.t}</h3>
            <p class="sp__text">{x.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sp" aria-labelledby="sp-steps">
    <div class="container sp__inner">
      <header class="sp__head">
        <p class="t-micro sp__idx">{num()} · {c.ui.formula.join(' → ')}</p>
        <h2 class="t-h3" id="sp-steps">{c.ui.howItWorks}</h2>
      </header>
      <div class="sp__body">
        <ol class="sp__steps">
          {seo.steps.map((x, i) => (
            <li class="sp__step">
              <p class="t-micro sp__stage">{pad(i + 1)} · {x.stage}</p>
              <div class="sp__stepBody">
                <h3 class="t-h4">{x.t}</h3>
                <p class="sp__text">{x.d}</p>
                {x.time && <p class="t-micro sp__time">{c.ui.timing}: <span class="t-micro--fg">{x.time}</span></p>}
              </div>
            </li>
          ))}
        </ol>
        <p class="t-small sp__foot">{c.ui.stepsNote}</p>
      </div>
    </div>
  </section>

  <section class="sp" aria-labelledby="sp-result">
    <div class="container sp__inner">
      <header class="sp__head">
        <p class="t-micro sp__idx">{num()}</p>
        <h2 class="t-h3" id="sp-result">{c.ui.result}</h2>
      </header>
      <ul class="sp__result">
        {seo.result.map((x) => <li>{x}</li>)}
      </ul>
    </div>
  </section>

  <section class="sp" aria-labelledby="sp-for">
    <div class="container sp__inner">
      <header class="sp__head">
        <p class="t-micro sp__idx">{num()}</p>
        <h2 class="t-h3" id="sp-for">{c.ui.forWhom}</h2>
      </header>
      <ul class="sp__grid sp__grid--two">
        {seo.forWhom.map((x) => (
          <li class="sp__card">
            <h3 class="t-h4">{x.t}</h3>
            <p class="sp__text">{x.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {cases.length > 0 && (
    <section class="sp" aria-labelledby="sp-cases">
      <div class="container sp__inner">
        <header class="sp__head">
          <p class="t-micro sp__idx">{num()}</p>
          <h2 class="t-h3" id="sp-cases">{c.ui.relatedCases}</h2>
        </header>
        <div class="sp__cases">
          {cases.map((k) => <CaseTile lang={lang} item={k} compact sizes="(max-width: 720px) 45vw, 260px" />)}
        </div>
      </div>
    </section>
  )}

  <section class="sp" aria-labelledby="sp-faq">
    <div class="container sp__inner">
      <header class="sp__head">
        <p class="t-micro sp__idx">{num()} · FAQ</p>
        <h2 class="t-h3" id="sp-faq">{c.ui.faq}</h2>
      </header>
      <div class="sp__faq">
        {seo.faq.map((x, i) => (
          <details class="faq" open={i === 0}>
            <summary class="faq__q"><span class="t-h4">{x.q}</span><span class="faq__mark" aria-hidden="true"></span></summary>
            <p class="faq__a">{x.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {articles.length > 0 && (
    <section class="sp" aria-labelledby="sp-articles">
      <div class="container sp__inner">
        <header class="sp__head">
          <p class="t-micro sp__idx">{num()}</p>
          <h2 class="t-h3" id="sp-articles">{c.ui.articlesTitle}</h2>
          <a class="t-micro sp__all" href={localePath(lang, `/insights/${d.id}/`)}>{c.ui.allInsights} →</a>
        </header>
        <ul class="sp__articles">
          {articles.map((x) => <li><InsightCard lang={lang} item={x} level={3} /></li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="sp" aria-labelledby="sp-siblings">
    <div class="container sp__inner">
      <header class="sp__head">
        <p class="t-micro sp__idx">{d.index} · {d.name}</p>
        <h2 class="t-h3" id="sp-siblings">{c.ui.siblings}</h2>
      </header>
      <div class="sp__body">
        <ul class="sib">
          {siblings.map((x) => (
            <li>
              <a class="sib__link" href={localePath(lang, `${dirPath}${x.id}/`)}>
                <span class="t-h4">{x.name}</span>
                <span class="t-small">{x.line}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="sp__actions">
          <Button href={`${localePath(lang, '/contact/')}?service=${s.id}`} variant="fill" magnetic={false}>{c.ui.serviceCta}</Button>
          <Button href={localePath(lang, dirPath)} variant="text" magnetic={false} arrow>{d.nameFull}</Button>
        </div>
      </div>
    </div>
  </section>

  <CtaBlock lang={lang} service={s.id} />
</Base>

<style>
  .sp {
    border-top: 1px solid var(--hair);
  }
  .sp--intro {
    border-top: 0;
  }
  .sp__intro {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    max-width: none;
  }
  .sp__introText {
    font-size: var(--fs-lead);
    line-height: 1.45;
    letter-spacing: -0.01em;
    max-width: 68ch;
    text-wrap: pretty;
  }
  .sp__note {
    max-width: 88ch;
    color: var(--fg-3);
  }
  .sp__note::before {
    content: '';
    display: inline-block;
    width: 14px;
    height: 1px;
    background: var(--accent);
    vertical-align: middle;
    margin-right: 10px;
  }
  .sp__inner {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-8) var(--space-12);
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    max-width: none;
  }
  .sp__head {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    position: sticky;
    top: calc(var(--header-h) + 1rem);
  }
  .sp__idx {
    color: var(--accent);
  }
  .sp__body {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }
  .sp__text {
    color: var(--fg-2);
    line-height: 1.5;
    max-width: 60ch;
  }
  .sp__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-6) var(--space-8);
  }
  .sp__grid--two {
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }
  .sp__card {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-top: var(--space-4);
    border-top: 1px solid var(--hair);
  }
  .sp__steps {
    display: grid;
    counter-reset: none;
  }
  .sp__step {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: var(--space-2) var(--space-6);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--hair);
  }
  .sp__step:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .sp__stage {
    color: var(--accent);
    padding-top: 0.35em;
  }
  .sp__stepBody {
    display: grid;
    gap: var(--space-2);
  }
  .sp__time {
    color: var(--fg-3);
  }
  .sp__foot {
    color: var(--fg-3);
  }
  .sp__result {
    display: grid;
    gap: var(--space-4);
  }
  .sp__result li {
    position: relative;
    padding-left: 1.4rem;
    font-size: var(--fs-h4);
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 52ch;
  }
  .sp__result li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 8px;
    height: 1px;
    background: var(--accent);
  }
  .sp__cases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4) var(--space-3);
    max-width: 820px;
  }
  .sp__faq {
    display: grid;
  }
  .faq {
    border-top: 1px solid var(--hair);
  }
  .faq:last-child {
    border-bottom: 1px solid var(--hair);
  }
  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-6);
    padding: var(--space-4) 0;
    cursor: pointer;
    list-style: none;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__q:hover .t-h4 {
    color: var(--accent);
  }
  /* плюс из двух волосяных линий; у открытого вопроса остаётся минус */
  .faq__mark {
    position: relative;
    flex: none;
    width: 12px;
    height: 12px;
  }
  .faq__mark::before,
  .faq__mark::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: currentColor;
    transition: transform var(--dur-fast);
  }
  .faq__mark::after {
    transform: rotate(90deg);
  }
  .faq[open] .faq__mark::after {
    transform: rotate(0deg);
  }
  .faq__a {
    padding-bottom: var(--space-6);
    color: var(--fg-2);
    line-height: 1.5;
    max-width: 64ch;
  }
  .sp__all {
    color: var(--fg-2);
    justify-self: start;
  }
  .sp__all:hover {
    color: var(--accent);
  }
  .sp__articles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--space-4);
  }
  .sib {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-4);
  }
  .sib__link {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--hair);
    height: 100%;
    transition: border-color var(--dur-fast);
  }
  .sib__link:hover {
    border-color: var(--hair-strong);
  }
  .sp__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-8);
  }
  @media (max-width: 899px) {
    .sp__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-top: var(--space-12);
      padding-bottom: var(--space-12);
    }
    .sp__head {
      position: static;
    }
    .sp__step {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .sp__cases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
