---
/**
 * BRIEF-7 §3: плавающая кнопка WhatsApp на всех страницах — справа внизу, круг 56 px (телефон 52), фон ink,
 * иконка белая (инлайн-SVG). Ссылка с предзаполненным текстом по языку. На главной появляется после home-ready.
 * Клик считает lib/site.ts (все ссылки wa.me → событие whatsapp_click).
 */
import { getContent, type LangCode } from '../lib/i18n';
import { WHATSAPP_URL } from '../../site.config';

export interface Props {
  lang: LangCode;
}
const { lang } = Astro.props;
const c = getContent(lang);
const href = `${WHATSAPP_URL}?text=${encodeURIComponent(c.ui.whatsappText)}`;
---

<a class="wa-fab" href={href} target="_blank" rel="noopener" aria-label={c.ui.whatsapp} data-wa-fab>
  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
    <path d="M12 3.1a8.9 8.9 0 0 0-7.7 13.4L3.1 20.9l4.5-1.2A8.9 8.9 0 1 0 12 3.1Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
    <path d="M8.9 7.8c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .6.4l.8 1.9c.1.2.1.4 0 .6l-.5.7c-.1.2-.2.3 0 .6.6 1 1.4 1.8 2.4 2.4.3.2.4.1.6 0l.7-.6c.2-.2.4-.2.6-.1l1.8.9c.3.1.4.3.4.5 0 .5-.2 1.2-.7 1.6-.5.4-1.3.7-2.4.4-1.4-.4-2.9-1.3-4.1-2.5s-2.1-2.6-2.5-4c-.3-1.1 0-1.9.4-2.4Z" fill="currentColor" />
  </svg>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: 20px;
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    z-index: 745;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    box-shadow: 0 6px 20px rgba(27, 26, 24, 0.18);
    transition:
      transform var(--dur-fast) var(--ease-out),
      opacity 0.6s var(--ease-out),
      visibility 0s;
  }
  .wa-fab:hover {
    transform: scale(1.04);
  }
  .wa-fab:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  /* главная: кнопка появляется вместе со сценой (body.home-ready), без JS — сразу */
  :global(body.is-home) .wa-fab {
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      transform 0.6s var(--ease-out),
      opacity 0.6s var(--ease-out),
      visibility 0s linear 0.6s;
  }
  :global(body.is-home.home-ready) .wa-fab,
  :global(html.no-js body.is-home) .wa-fab {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  :global(body.is-home.home-ready) .wa-fab:hover {
    transform: scale(1.04);
  }
  /* главная: в правом нижнем углу экранов стоят ссылки («Наши кейсы» в S1, «Страница направления →» в S2–S6 на ПК) —
     на этих экранах кнопка поднимается над ними; body[data-screen] ставит сценарий главной */
  @media (min-width: 900px) {
    :global(body.is-home.home-ready:is([data-screen='0'], [data-screen='1'], [data-screen='2'], [data-screen='3'], [data-screen='4'], [data-screen='5'])) .wa-fab {
      bottom: calc(112px + env(safe-area-inset-bottom, 0px));
    }
  }
  @media (max-width: 899px) {
    :global(body.is-home.home-ready[data-screen='0']) .wa-fab {
      bottom: calc(100px + env(safe-area-inset-bottom, 0px));
    }
  }
  :global(body.is-home.home-ready) .wa-fab {
    transition:
      transform 0.6s var(--ease-out),
      opacity 0.6s var(--ease-out),
      bottom 0.5s var(--ease-out),
      visibility 0s;
  }
  @media (max-width: 899px) {
    .wa-fab {
      width: 52px;
      height: 52px;
    }
    .wa-fab svg {
      width: 24px;
      height: 24px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-fab,
    .wa-fab:hover {
      transition: none;
      transform: none;
    }
  }
  @media print {
    .wa-fab {
      display: none;
    }
  }
</style>
