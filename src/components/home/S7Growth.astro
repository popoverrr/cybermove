---
/**
 * S7 · РОСТ — GROWTH. BRIEF-7 §2: заголовок → лента избранных кейсов (полноразмерные карточки 4:5, 3 / 2 / 1 в ряд,
 * горизонтальная прокрутка: свайп, перетаскивание, кнопки, индикатор «03 / 05») → счётчики → «Все кейсы» → тикер.
 * Если содержимое выше экрана, блок доезжает вверх внутри pin в фазе удержания (home-extra.ts) — у S7 две точки покоя снапа.
 */
import Button from '../Button.astro';
import CaseFrame from '../CaseFrame.astro';
import { getContent, localePath, findCase, type LangCode } from '../../lib/i18n';
import { TICKER } from '../../../site.config';

export interface Props {
  lang: LangCode;
}
const { lang } = Astro.props;
const c = getContent(lang);
const s7 = c.home.s7;
const h2 = s7.h2;
const featured = s7.featured.map((id) => findCase(c, id)).filter(Boolean) as NonNullable<ReturnType<typeof findCase>>[];
/** id фотослотов избранных кейсов (media.json) */
const SLOT: Record<string, string> = { usyk: 'case-usyk', 'ukrainian-fashion-week': 'case-ufw', intertop: 'case-intertop', 'brsm-nafta': 'case-brsm', 'hydrosta-kazakhstan': 'case-hydrosta' };
const tickerItems = [...TICKER, ...TICKER];
const total = String(featured.length).padStart(2, '0');
---

<section class="screen screen--s7" data-screen="growth" data-dur="240" data-dur-mobile="220" id="growth" data-theme="ivory" aria-labelledby="h-growth">
  <div class="screen__pin">
    <div class="g container" data-growth>
      <p class="g__corner g__corner--tr t-micro" data-tw>GROWTH · RINGS · {c.home.s7.counters[0].value}+</p>
      <div class="g__head" data-tw>
        <p class="t-micro g__label">{s7.label}</p>
        <h2 class="t-h1 g__h2" id="h-growth" set:html={h2} />
      </div>

      <div class="ribbon-wrap" data-tw>
        <ul class="ribbon" data-ribbon data-lenis-prevent-horizontal>
          {featured.map((k) => (
            <li class="ribbon__item" data-ribbon-item>
              <a class="card" href={localePath(lang, `/cases/${k.id}/`)} draggable="false">
                {/* BRIEF-7 §2: кадр = карточка (4:5, cover), логотип в углу и имя на градиенте — правила CaseTile */}
                <CaseFrame id={SLOT[k.id] ?? `case-${k.id}`} name={k.name} lang={lang} ratio="4:5" sizes="(max-width: 699px) 90vw, (max-width: 1099px) 46vw, 30vw" class="card__photo" />
                <span class="card__tags t-micro">{k.tags.join(' · ')}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="ribbon__bar">
          <span class="t-micro ribbon__count" data-ribbon-count aria-live="polite"><span data-ribbon-pos>03</span> / {total}</span>
          <span class="ribbon__nav">
            <button class="ribbon__btn" type="button" data-ribbon-prev aria-label={lang === 'ru' ? 'Предыдущие кейсы' : 'Previous cases'}>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13.5 8h-10M7.5 3.5 3 8l4.5 4.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" /></svg>
            </button>
            <button class="ribbon__btn" type="button" data-ribbon-next aria-label={lang === 'ru' ? 'Следующие кейсы' : 'Next cases'}>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8h10M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" /></svg>
            </button>
          </span>
        </div>
      </div>

      <ul class="counters" data-counters data-tw>
        {s7.counters.map((k) => (
          <li class="counter">
            <p class="counter__value t-counter"><span data-count={k.value}>{k.value}</span>{k.suffix}</p>
            <p class="counter__label t-micro">{k.label}</p>
          </li>
        ))}
      </ul>

      <div class="g__foot" data-tw>
        <Button href={localePath(lang, '/cases/')} variant="ghost" arrow>{s7.cta}</Button>
      </div>
    </div>

    <div class="g__ticker" aria-hidden="true">
      <div class="ticker">
        <div class="ticker__track ticker__track--rev">
          {tickerItems.map((t) => <span class="ticker__item t-micro">{t}</span>)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .g {
    --gap: var(--space-4);
    /* высота, которую над карточками и под ними занимают шапка, заголовок, теги и тикер: карточка в верхней точке
       покоя помещается целиком вместе с заголовком */
    --reserve: calc(var(--header-h) + 262px);
    position: relative;
    /* высота по содержимому: если оно выше экрана, блок доезжает вверх (home-extra.ts), обрезает pin */
    min-height: 100%;
    display: grid;
    grid-template-rows: auto auto auto auto;
    align-content: start;
    padding-top: calc(var(--header-h) + var(--space-6));
    /* «Все кейсы» — над кнопкой SOUND (Base.astro: низ 24 px, высота 44) с зазором 16 px */
    padding-bottom: calc(var(--space-6) + 44px + var(--space-4));
    max-width: none;
    row-gap: var(--space-6);
    will-change: transform;
  }
  /* полоса шапки: доехавшее вверх содержимое уходит под неё мягко, без наложения на логотип */
  :global(.screen--s7) > :global(.screen__pin) {
    mask-image: linear-gradient(180deg, transparent calc(var(--header-h) - 6px), #000 calc(var(--header-h) + 18px));
    -webkit-mask-image: linear-gradient(180deg, transparent calc(var(--header-h) - 6px), #000 calc(var(--header-h) + 18px));
  }
  .g__corner {
    position: absolute;
    top: calc(var(--header-h) + var(--space-6));
    right: var(--gutter);
    margin: 0;
  }
  .g__head {
    display: grid;
    gap: var(--space-3);
    max-width: 56%;
  }
  .g__label {
    color: var(--accent);
  }
  .g__h2 {
    font-size: min(var(--fs-h1), 7.5vh);
  }

  /* ---------- лента: три карточки в ряд, дальше — горизонтальная прокрутка ---------- */
  .ribbon-wrap {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }
  .ribbon {
    --per: 3;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    touch-action: pan-x pan-y;
    cursor: grab;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ribbon::-webkit-scrollbar {
    display: none;
  }
  .ribbon.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }
  .ribbon.is-dragging .card {
    pointer-events: none;
  }
  .ribbon__item {
    /* ширина = (контейнер − зазоры) / N, но не выше свободной высоты экрана (4:5) */
    flex: 0 0 min(calc((100% - (var(--per) - 1) * var(--gap)) / var(--per)), calc((100svh - var(--reserve)) * 0.8));
    scroll-snap-align: start;
  }
  .card {
    display: grid;
    gap: var(--space-2);
    color: inherit;
    user-select: none;
    -webkit-user-drag: none;
  }
  .card :global(.card__photo) {
    width: 100%;
    --frame-name-fs: clamp(15px, 1.3vw, 20px);
  }
  .card :global(img) {
    -webkit-user-drag: none;
  }
  .card__tags {
    color: var(--fg-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* индикатор и кнопки слева: правый нижний угол занимает кнопка WhatsApp */
  .ribbon__bar {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-4);
  }
  .ribbon__count {
    color: var(--fg-2);
  }
  .ribbon__nav {
    display: inline-flex;
    gap: var(--space-2);
  }
  .ribbon__btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--hair-strong);
    color: var(--fg);
    transition: border-color var(--dur-fast), opacity var(--dur-fast);
  }
  .ribbon__btn:hover {
    border-color: var(--fg);
  }
  .ribbon__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .ribbon__btn:disabled:hover {
    border-color: var(--hair-strong);
  }

  /* ---------- счётчики ниже карточек ---------- */
  .counters {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5, 1.25rem);
    border-top: 1px solid var(--hair);
    padding-top: var(--space-3);
    margin: 0;
    list-style: none;
  }
  .counter {
    display: grid;
    gap: var(--space-2);
  }
  .counter__value {
    font-size: min(var(--fs-counter), 7vh);
    color: var(--fg);
  }
  .counter__label {
    color: var(--fg-2);
  }
  .g__foot {
    display: flex;
    justify-content: flex-start;
  }

  /* тикер поверх содержимого: своя бумага, чтобы карточки не просвечивали под ним (BRIEF-4 §1.1) */
  .g__ticker {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: 48px;
    background: var(--paper);
    border-top: 1px solid var(--hair);
    padding-inline: var(--gutter);
    padding-left: calc(var(--gutter) + var(--rail-offset, 0px));
    display: flex;
    align-items: center;
  }
  .ticker {
    overflow: hidden;
    width: 100%;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .ticker__track {
    display: flex;
    gap: var(--space-12);
    width: max-content;
    animation: ticker-rev 56s linear infinite;
  }
  .ticker__item {
    white-space: nowrap;
    color: var(--fg-2);
  }
  @keyframes ticker-rev {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker__track {
      animation: none;
    }
  }

  /* планшет: две карточки в ряд */
  @media (max-width: 1099px) {
    .ribbon {
      --per: 2;
    }
  }
  /* телефон: одна карточка на ширину контейнера (−16 px, край следующей виден), не выше 62vh */
  @media (max-width: 699px) {
    .g {
      --reserve: calc(var(--header-h) + 170px);
      padding-top: calc(var(--header-h) + var(--space-4));
      row-gap: var(--space-4);
    }
    .ribbon__item {
      flex-basis: min(calc(100% - 16px), calc(62vh * 0.8), calc((100svh - var(--reserve)) * 0.8));
    }
    .g__corner {
      display: none;
    }
    .g__head {
      max-width: 100%;
    }
    .g__h2 {
      font-size: clamp(1.6rem, 6.6vw, 2.2rem);
    }
    /* на телефоне сцена проходит за счётчиками: полоса бумаги во всю ширину не даёт шару лечь на цифры */
    .counters {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-2);
      background: var(--paper);
      margin-inline: calc(var(--gutter) * -1);
      padding: var(--space-3) var(--gutter);
      border-bottom: 1px solid var(--hair);
    }
    .counter__value {
      font-size: clamp(1.6rem, 6.4vw, 2rem);
    }
    .ribbon__btn {
      width: 36px;
      height: 36px;
    }
    .g__ticker {
      height: 40px;
    }
  }
  @media (max-width: 899px) {
    /* SOUND на телефоне и планшете выше: низ 16 + 44 px, высота 44 */
    .g {
      padding-bottom: calc(var(--space-4) + 44px + 44px + var(--space-3));
    }
    .g__corner {
      display: none;
    }
    .g__head {
      max-width: 100%;
    }
  }
</style>
