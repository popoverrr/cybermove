{
  "name": "cybermove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CYBERMOVE — сайт консалтинговой компании. Astro (static) + Three.js + GSAP + Lenis, PHP-форма для Plesk.",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/og.mjs && astro build",
    "build:labs": "node scripts/og.mjs && cross-env CYBERMOVE_LABS=1 astro build",
    "preview": "astro preview",
    "check": "astro check",
    "logo": "node scripts/build-logo.mjs",
    "shots": "node scripts/shots.mjs",
    "posters": "node scripts/posters.mjs",
    "audit": "node scripts/audit-dist.mjs",
    "deploy": "npm run build && node deploy/deploy-ftp.mjs",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "postprocessing": "^6.39.5",
    "three": "^0.186.0",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tweakpane/core": "^2.0.5",
    "@types/three": "^0.186.0",
    "astro": "^7.3.3",
    "basic-ftp": "^6.2.1",
    "cross-env": "^10.1.0",
    "fontkit": "^2.0.4",
    "lighthouse": "^13.5.0",
    "node-html-parser": "^9.0.4",
    "playwright": "^1.63.0",
    "satori": "^0.33.5",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
