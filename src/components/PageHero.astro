---
/**
 * Шапка внутренней страницы (BRIEF §10): лёгкий шейдерный фон в теме направления (lite-bg, без three)
 * и статичный рендер объекта направления (постер из docs/screens → public/posters, Фаза 5).
 */
export interface Props {
  theme: 'ivory' | 'sand' | 'stone' | 'clay';
  label: string;
  title: string;
  lead?: string;
  micro?: string[];
  render?: string;
  /** id фотослота 16:9 (media.json) вместо постера (не `slot` — это зарезервированный атрибут Astro) */
  photo?: string;
  beam?: number;
  accent?: string;
  size?: 'lg' | 'md';
  /** BRIEF-SEO §1: видимые хлебные крошки над заголовком (последний пункт — текущая страница, без ссылки) */
  crumbs?: Array<{ name: string; href?: string }>;
  /** BRIEF-SEO §1: ключевая фраза страницы — микрометка встаёт внутрь H1 (визуально та же строка над заголовком) */
  kicker?: string;
  /** длинный заголовок (страницы услуг): шире колонка */
  wide?: boolean;
  ariaCrumbs?: string;
}
import { withBase } from '../lib/base';
import ImageSlot from './ImageSlot.astro';
const { theme, label, title, lead, micro = [], render, photo, beam = 0, accent, size = 'lg', crumbs = [], kicker, wide = false, ariaCrumbs = 'Breadcrumbs' } = Astro.props;
const renderUrl = render ? withBase(render) : '';
const html = title;
---

<section class:list={['phero', `phero--${size}`, { 'phero--wide': wide }]} data-theme={theme} data-lite-bg={theme} data-beam={beam}>
  <canvas class="phero__bg" aria-hidden="true"></canvas>
  {photo ? (
    <div class="phero__slot" aria-hidden="true"><ImageSlot id={photo} ratio="16:9" alt="" sizes="(max-width: 899px) 100vw, 52vw" eager /></div>
  ) : (
    renderUrl && <div class="phero__render" style={`background-image:url(${renderUrl})`} aria-hidden="true"></div>
  )}
  <div class="phero__inner container">
    {crumbs.length > 0 && (
      <nav class="phero__crumbs t-micro" aria-label={ariaCrumbs}>
        <ol>
          {crumbs.map((c, i) => (
            <li>
              {c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {kicker ? (
      <h1 class="t-h1 phero__title">
        <span class="t-micro phero__label phero__kicker" data-label={`${label} · `}>{kicker}</span>{' '}<span set:html={html} />
      </h1>
    ) : (
      <>
        {!crumbs.length && <p class="t-micro phero__label">{label}</p>}
        <h1 class="t-h1 phero__title" set:html={html} />
      </>
    )}
    {lead && <p class="t-lead phero__lead">{lead}</p>}
    {micro.length > 0 && <p class="t-micro phero__micro">{micro.join(' · ')}</p>}
    <span class="crosshair phero__cross" aria-hidden="true"></span>
  </div>
</section>

<script>
  import { mountLiteBackground } from '../webgl/backgrounds/lite-bg';
  const el = document.querySelector<HTMLElement>('[data-lite-bg]');
  const canvas = el?.querySelector<HTMLCanvasElement>('canvas');
  if (el && canvas) {
    // BRIEF-SEO §6: WebGL-фон — после первой отрисовки, когда браузер свободен (LCP остаётся за текстом)
    const mount = () => {
      try {
        mountLiteBackground(canvas, el.dataset.liteBg as never, { beam: Number(el.dataset.beam || 0) });
      } catch {
        /* остаётся CSS-фон */
      }
    };
    if ('requestIdleCallback' in window) window.requestIdleCallback(mount, { timeout: 2000 });
    else setTimeout(mount, 300);
  }
</script>

<style>
  .phero {
    position: relative;
    background: var(--bg);
    color: var(--fg);
    overflow: hidden;
    padding-top: var(--header-h);
  }
  .phero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s var(--ease-out);
  }
  .phero__bg.is-ready {
    opacity: 1;
  }
  .phero__render {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 52%;
    background-size: contain;
    background-position: center right;
    background-repeat: no-repeat;
    pointer-events: none;
    mask-image: linear-gradient(90deg, transparent, #000 25%);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 25%);
  }
  /* фотослот 16:9 справа: край уходит за экран, слева мягкая маска под текст */
  .phero__slot {
    position: absolute;
    right: 0;
    top: var(--header-h);
    bottom: 0;
    width: 52%;
    display: grid;
    align-items: center;
    pointer-events: none;
    mask-image: linear-gradient(90deg, transparent, #000 22%);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 22%);
  }
  .phero__inner {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding-top: clamp(3rem, 8vh, 6rem);
    padding-bottom: clamp(3rem, 8vh, 6rem);
    min-height: 52vh;
    align-content: center;
    max-width: none;
  }
  .phero--md .phero__inner {
    min-height: 36vh;
  }
  .phero__label {
    color: var(--accent);
  }
  .phero__title {
    max-width: 14ch;
  }
  .phero--wide .phero__title {
    max-width: 20ch;
  }
  /* микрометка внутри H1: та же строка над заголовком, что и отдельная метка */
  /* индекс и этап — генерируемым текстом: видны, но не входят в текст H1 */
  .phero__kicker::before {
    content: attr(data-label);
  }
  .phero__kicker {
    display: block;
    margin-bottom: var(--space-4);
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-micro);
  }
  .phero__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
    color: var(--fg-2);
  }
  .phero__crumbs li + li::before {
    content: '/';
    margin-right: 0.6rem;
    color: var(--fg-3);
  }
  .phero__crumbs a:hover {
    color: var(--accent);
  }
  .phero__lead {
    max-width: 52ch;
  }
  .phero__micro {
    margin-top: var(--space-4);
  }
  .phero__cross {
    right: calc(var(--gutter) - 5px);
    bottom: var(--space-8);
  }
  /* BRIEF-4 §1.6: на телефоне картинка стоит над заголовком (40 vh), а не за ним */
  @media (max-width: 899px) {
    .phero__slot {
      position: relative;
      top: 0;
      width: 100%;
      height: 40vh;
      mask-image: none;
      -webkit-mask-image: none;
      padding-inline: var(--gutter);
      margin-top: var(--space-4);
    }
    .phero__slot :global(.slot) {
      aspect-ratio: auto;
      height: 100%;
    }
    .phero__render {
      position: relative;
      width: 100%;
      height: 40vh;
      margin-top: var(--space-4);
      opacity: 1;
      background-size: cover;
      background-position: 50% 45%;
      mask-image: none;
      -webkit-mask-image: none;
    }
    .phero__inner {
      min-height: 0;
      padding-top: var(--space-6);
    }
  }
</style>
