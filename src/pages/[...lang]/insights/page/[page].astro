---
/** /insights/page/<n>/ — страницы списка со второй (по 12 разборов). Первая — /insights/. */
import InsightsList from '../../../../components/InsightsList.astro';
import { getContent, type LangCode } from '../../../../lib/i18n';
import { getInsights, PAGE_SIZE } from '../../../../lib/insights';
import { LANGS } from '../../../../../site.config';

export async function getStaticPaths() {
  const out: Array<{ params: { lang: string | undefined; page: string }; props: { lang: LangCode; page: number } }> = [];
  for (const l of LANGS) {
    const all = await getInsights(l.code);
    const pages = Math.ceil(all.length / PAGE_SIZE);
    for (let n = 2; n <= pages; n++) out.push({ params: { lang: l.prefix || undefined, page: String(n) }, props: { lang: l.code, page: n } });
  }
  return out;
}
const { lang, page } = Astro.props;
const c = getContent(lang);
const all = await getInsights(lang);
const pages = Math.ceil(all.length / PAGE_SIZE);
const directions = [...new Set(all.map((x) => x.entry.data.direction))];
const path = `/insights/page/${page}/`;
---

<InsightsList
  lang={lang}
  path={path}
  title={`${c.ui.meta.insights.title.replace(' — ', ` · ${c.ui.pageLabel} ${page} — `)}`}
  description={c.ui.meta.insights.description}
  h1={c.ui.insightsH1}
  lead={c.ui.insightsLead}
  label={`${c.ui.insights} · ${c.ui.pageLabel} ${page}`}
  items={all.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE)}
  directions={directions}
  page={page}
  pages={pages}
  crumbs={[
    { name: c.ui.home, path: '/' },
    { name: c.ui.insights, path: '/insights/' },
    { name: `${c.ui.pageLabel} ${page}`, path },
  ]}
/>
