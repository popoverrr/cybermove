---
/**
 * /cases/<id>/ — страница кейса (MEDIA-INTEGRATION §3): плитка бренда в шапке, «Проект», «Задача»,
 * «Роль CYBERMOVE», «Что было сделано», дополнительные блоки, «Результат», «Дисциплины», ссылка на сайт
 * клиента и CTA. Тексты — src/content/<lang>/cases-detailed.json, плитки — media.json (`cases-<id>`).
 */
import Base from '../../../layouts/Base.astro';
import CtaBlock from '../../../components/CtaBlock.astro';
import Button from '../../../components/Button.astro';
import CaseFrame from '../../../components/CaseFrame.astro';
import CaseTile from '../../../components/CaseTile.astro';
import { getContent, localePath, findCase, findCaseDetails, type LangCode } from '../../../lib/i18n';
import { LANGS, SITE_URL } from '../../../../site.config';
import { breadcrumbLd, canonical } from '../../../lib/seo';
import { caseServices } from '../../../lib/case-services';

export function getStaticPaths() {
  const out: Array<{ params: { lang: string | undefined; slug: string }; props: { lang: LangCode; slug: string } }> = [];
  for (const l of LANGS) {
    const c = getContent(l.code);
    for (const item of c.cases.items) {
      out.push({ params: { lang: l.prefix || undefined, slug: item.id }, props: { lang: l.code, slug: item.id } });
    }
  }
  return out;
}

const { lang, slug } = Astro.props;
const c = getContent(lang);
const item = findCase(c, slug)!;
const d = findCaseDetails(c, slug);
const path = `/cases/${slug}/`;
const cat = c.cases.categories.find((x) => x.id === item.category);
const idx = c.cases.items.findIndex((x) => x.id === slug);
const next = c.cases.items[(idx + 1) % c.cases.items.length];
// BRIEF-SEO §3: «{name}: {категория} — кейс CYBERMOVE»; если длиннее 60 знаков — без категории
const titleCat = cat ? c.ui.meta.caseItem.titleCat.replace('{name}', item.name).replace('{category}', cat.short) : '';
const title = titleCat && titleCat.length <= 60 ? titleCat : c.ui.meta.caseItem.title.replace('{name}', item.name);
const services = caseServices(c, slug, d?.disciplines ?? item.tags);
// похожие кейсы: та же категория, по кругу от текущего
const sameCat = c.cases.items.filter((x) => x.category === item.category && x.id !== slug);
const pos = c.cases.items.filter((x) => x.category === item.category).findIndex((x) => x.id === slug);
const similar = [...sameCat.slice(pos), ...sameCat.slice(0, pos)].slice(0, 3);
const description = c.ui.meta.caseItem.description.replace('{summary}', item.summary);
const jsonLd = [
  breadcrumbLd(lang, [
    { name: c.ui.brand, path: '/' },
    { name: c.cases.title, path: '/cases/' },
    { name: item.name, path },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: item.name,
    headline: item.name,
    description: d?.project || item.summary,
    url: canonical(lang, path),
    inLanguage: lang,
    // клиент — только имя и ссылка из данных кейса; личные бренды — Person
    about: {
      '@type': item.category === 'experts' ? 'Person' : 'Organization',
      name: item.name,
      ...(item.url ? { url: item.url } : {}),
    },
    genre: cat?.label,
    keywords: [...(d?.disciplines || item.tags), ...(d?.industries || '').split('·').map((x) => x.trim()).filter(Boolean)].join(', '),
    creator: { '@id': `${SITE_URL}/#organization` },
    ...(services.length ? { mentions: services.map((x) => ({ '@type': 'Service', name: x.name, url: canonical(lang, x.href) })) } : {}),
  },
];
---

<Base lang={lang} path={path} title={title} description={description} theme="ivory" jsonLd={jsonLd}>
  <article class="case-page">
    <header class="chead">
      <div class="container chead__inner">
        <CaseFrame
          id={`cases-${slug}`}
          name={item.name}
          lang={lang}
          ratio="16:9"
          use="hero"
          logoWidth={0.18}
          sizes="(max-width: 899px) 100vw, 88vw"
          widths={[640, 960, 1280, 1440]}
          hideName
          zoom={false}
          eager
          priority
          class="chead__frame"
        />
        <div class="chead__text">
          <p class="t-micro chead__meta">
            <a href={localePath(lang, '/cases/')}>{c.cases.title}</a>
            <span>·</span>
            <span>{String(item.n).padStart(2, '0')}</span>
            {cat && <><span>·</span><span>{cat.label}</span></>}
          </p>
          <h1 class="t-h1 chead__title">{item.name}</h1>
          <p class="t-lead chead__lead">{item.summary}</p>
          {d && <p class="t-micro chead__ind">{d.industries}</p>}
          {item.url && (
            <p class="t-micro chead__link">
              <a href={item.url} target="_blank" rel="noopener nofollow">{item.urlLabel || item.url} ↗</a>
            </p>
          )}
        </div>
      </div>
    </header>

    <div class="container cbody">
      {d?.project && (
        <section class="cblock">
          <h2 class="t-micro cblock__label">{c.ui.caseProject}</h2>
          <p class="t-body cblock__text">{d.project}</p>
        </section>
      )}

      {d?.task && (
        <section class="cblock">
          <h2 class="t-micro cblock__label">{c.ui.caseTask}</h2>
          <p class="t-body cblock__text">{d.task}</p>
        </section>
      )}

      {d?.role && (
        <section class="cblock">
          <h2 class="t-micro cblock__label">{c.ui.caseRole}</h2>
          <p class="t-body cblock__text">{d.role}</p>
        </section>
      )}

      {d && d.done.length > 0 && (
        <section class="cblock">
          <h2 class="t-micro cblock__label">{c.ui.caseDone}</h2>
          <ul class="clist">
            {d.done.map((x, i) => (
              <li class="clist__item">
                <span class="t-micro clist__n">{String(i + 1).padStart(2, '0')}</span>
                <span class="t-body">{x}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {d?.extraBlocks.map((b) => (
        <section class="cblock">
          <h2 class="t-micro cblock__label">{b.title}</h2>
          <div class="cblock__body">
            <p class="t-body cblock__text">{b.lead}</p>
            <ul class="clist clist--plain">
              {b.items.map((x) => (
                <li class="clist__item"><span class="t-body">{x}</span></li>
              ))}
            </ul>
          </div>
        </section>
      ))}

      {d?.result ? (
        <section class="cblock">
          <h2 class="t-micro cblock__label">{c.ui.caseResult}</h2>
          <p class="t-body cblock__text">{d.result}</p>
        </section>
      ) : (
        <section class="cblock">
          <h2 class="t-micro cblock__label">{c.ui.caseResult}</h2>
          <p class="t-small cblock__ph">{c.cases.resultPlaceholder}</p>
        </section>
      )}

      {d && d.disciplines.length > 0 && (
        <section class="cblock">
          <h2 class="t-micro cblock__label">{c.ui.caseDisciplines}</h2>
          <p class="t-micro cblock__dis">{d.disciplines.join(' · ')}</p>
        </section>
      )}

      {services.length > 0 && (
        <section class="cblock">
          <h2 class="t-micro cblock__label">{c.ui.caseServices}</h2>
          <ul class="csvc">
            {services.map((x) => (
              <li>
                <a class="csvc__link" href={localePath(lang, x.href)}>
                  <span class="t-micro csvc__dir">{x.direction}</span>
                  <span class="csvc__name">{x.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {similar.length > 0 && (
        <section class="cblock cblock--similar">
          <h2 class="t-micro cblock__label">{c.ui.caseSimilar}</h2>
          <div class="csim">
            {similar.map((k) => <CaseTile lang={lang} item={k} compact sizes="(max-width: 720px) 45vw, 260px" />)}
          </div>
        </section>
      )}

      <div class="cfoot">
        <Button href={localePath(lang, '/contact/')} arrow>{c.ui.caseDiscuss}</Button>
        <a class="t-micro cfoot__next" href={localePath(lang, `/cases/${next.id}/`)}>{c.ui.caseNext}: {next.name} →</a>
      </div>
    </div>
  </article>

  <CtaBlock lang={lang} />
</Base>

<style>
  .chead {
    background: var(--bg);
    padding-top: var(--header-h);
  }
  /* BRIEF-5 §4: кадр 16:9 с логотипом в углу, заголовок под ним */
  .chead__inner {
    display: grid;
    gap: var(--space-8);
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
    max-width: none;
  }
  /* класс уезжает внутрь компонента, поэтому :global; высота — чтобы заголовок оставался в первом экране */
  .chead__inner :global(.chead__frame) {
    /* ширина по контейнеру, высота ограничена — кадр кадрируется по cover, заголовок остаётся в первом экране */
    width: 100%;
    max-height: min(52vh, 480px);
  }
  .chead__text {
    display: grid;
    gap: var(--space-4);
  }
  .chead__meta {
    display: flex;
    gap: 0.5rem;
    /* функциональная навигационная строка — вторичный цвет (контраст ≥ 4.5:1) */
    color: var(--fg-2);
  }
  .chead__meta a:hover {
    color: var(--accent);
  }
  .chead__title {
    max-width: 16ch;
  }
  .chead__lead {
    max-width: 46ch;
  }
  .chead__ind {
    color: var(--fg-2);
  }
  .chead__link a {
    border-bottom: 1px solid var(--hair-strong);
    color: var(--fg-2);
  }
  .chead__link a:hover {
    color: var(--accent);
  }
  .cbody {
    display: grid;
    gap: var(--space-8);
    padding-top: var(--section-pad);
    padding-bottom: var(--section-pad);
    max-width: none;
  }
  .cblock {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 8fr);
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--hair);
  }
  .cblock__label {
    color: var(--accent);
  }
  /* BRIEF-SEO §3: услуги в проекте — ссылки на страницы услуг */
  .csvc {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-3);
  }
  .csvc__link {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--hair);
    height: 100%;
    transition: border-color var(--dur-fast);
  }
  .csvc__link:hover {
    border-color: var(--hair-strong);
  }
  .csvc__dir {
    color: var(--fg-2);
  }
  .csim {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4) var(--space-3);
    max-width: 820px;
  }
  @media (max-width: 720px) {
    .csim {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .cblock__body {
    display: grid;
    gap: var(--space-3);
  }
  .cblock__text {
    max-width: 68ch;
  }
  .clist {
    display: grid;
    gap: var(--space-3);
  }
  .clist__item {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: baseline;
    gap: var(--space-3);
    max-width: 68ch;
  }
  .clist--plain .clist__item {
    grid-template-columns: 1fr;
  }
  .clist__n {
    color: var(--fg-2);
  }
  .cfoot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--hair);
  }
  .cfoot__next {
    color: var(--fg-2);
  }
  .cblock__ph,
  .cblock__dis {
    color: var(--fg-2);
  }
  .cfoot__next:hover {
    color: var(--accent);
  }
  @media (max-width: 899px) {
    .chead__inner {
      gap: var(--space-6);
    }
    .cblock {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
