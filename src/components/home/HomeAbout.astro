---
/**
 * Блок «О компании» на главной (BRIEF-2 §6): в потоке между S7 и S8, вне стейджа, без pin.
 * Слева фотослот 3:4, справа метка / ABOUT, заголовок в две строки (вторая — bark), три тезиса
 * «Почему CYBERMOVE» (CONTENT.md §3) и ссылка «О компании →». Непрозрачный фон sand закрывает канвас.
 */
import ImageSlot from '../ImageSlot.astro';
import { getContent, localePath, type LangCode } from '../../lib/i18n';

export interface Props {
  lang: LangCode;
}
const { lang } = Astro.props;
const c = getContent(lang);
const a = c.home.about;
---

<section class="habout" data-theme="sand" aria-labelledby="h-habout">
  <div class="habout__inner container">
    <div class="habout__photo">
      <ImageSlot id="about-home" ratio="3:4" alt="" sizes="(max-width: 899px) 100vw, 44vw" />
    </div>
    <div class="habout__text">
      <p class="t-micro habout__label">{a.label}</p>
      <h2 class="t-h1 habout__h2" id="h-habout">
        {a.h2a}<br /><span class="t-dim">{a.h2b}</span>
      </h2>
      <ul class="habout__why">
        {c.about.why.map((w, i) => (
          <li class="habout__item">
            <span class="t-micro habout__num">0{i + 1}</span>
            <span class="habout__name">{w.name}</span>
            <span class="habout__desc t-body">{w.text}</span>
          </li>
        ))}
      </ul>
      <a class="habout__link t-micro" href={localePath(lang, '/about/')}>{a.link} →</a>
    </div>
  </div>
</section>

<style>
  .habout {
    position: relative;
    z-index: 1;
    background: var(--sand);
    color: var(--fg);
    padding: var(--section-pad) 0;
  }
  .habout__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .habout__text {
    display: grid;
    gap: var(--space-6);
    max-width: 560px;
  }
  .habout__label {
    color: var(--fg-2);
  }
  .habout__h2 {
    font-size: min(var(--fs-h2), 6.5vh);
  }
  .habout__why {
    display: grid;
    border-top: 1px solid var(--hair);
    margin-top: var(--space-2);
  }
  .habout__item {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    grid-template-areas:
      'num name'
      'num desc';
    column-gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--hair);
  }
  .habout__num {
    grid-area: num;
    padding-top: 0.35em;
    color: var(--fg-2);
  }
  .habout__name {
    grid-area: name;
    font-weight: 460;
    letter-spacing: -0.01em;
    font-size: var(--fs-h4);
    line-height: 1.2;
  }
  .habout__desc {
    grid-area: desc;
    color: var(--fg-2);
    margin-top: 0.25em;
    max-width: 44ch;
  }
  .habout__link {
    color: var(--fg);
    justify-self: start;
    padding-bottom: 0.3em;
    border-bottom: 1px solid var(--hair-strong);
    transition: border-color var(--dur-fast);
  }
  .habout__link:hover {
    border-color: var(--fg);
  }
  @media (max-width: 899px) {
    .habout__inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .habout__photo {
      max-width: 420px;
    }
    .habout__h2 {
      font-size: clamp(1.9rem, 7vw, 2.6rem);
    }
  }
</style>
