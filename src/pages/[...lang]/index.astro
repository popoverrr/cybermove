---
/** Главная: 8 экранов со сквозной 3D-сценой (BRIEF §7). */
import Base from '../../layouts/Base.astro';
import S1Core from '../../components/home/S1Core.astro';
import { getContent, langStaticPaths } from '../../lib/i18n';
import '../../styles/home.css';

export function getStaticPaths() {
  return langStaticPaths();
}

const { lang } = Astro.props;
const c = getContent(lang);
const s1 = c.home.s1;
const stubs = c.services.directions;
---

<Base lang={lang} path="/" title={c.ui.meta.home.title} description={c.ui.meta.home.description} theme="black" bodyClass="is-home" noFooter>
  <div class="gl-wrap" aria-hidden="true">
    <div class="gl-poster" data-poster></div>
    <canvas id="gl" class="gl-canvas"></canvas>
  </div>

  <div class="orbit-labels" aria-hidden="true">
    {s1.orbits.map((label, i) => (
      <button class="orbit-label t-micro" type="button" data-orbit-label={i} tabindex="-1">
        <span class="orbit-label__dot"></span>
        <span class="orbit-label__text">{label}</span>
      </button>
    ))}
  </div>

  <div class="stage-wrap" data-stage-wrap>
    <div class="stage" data-stage>
      <S1Core lang={lang} />

      {stubs.map((d) => (
        <section class="screen screen--stub" data-screen={d.id} data-dur="160" id={d.id} data-theme={d.theme}>
          <div class="screen__pin">
            <div class="container stub">
              <p class="t-micro">{d.screenLabel}</p>
              <h2 class="t-h1">{d.h2}</h2>
              <p class="t-lead">{d.phrase}</p>
            </div>
          </div>
        </section>
      ))}
      <section class="screen screen--stub screen--s7" data-screen="growth" data-dur="170" id="growth" data-theme="black">
        <div class="screen__pin">
          <div class="container stub">
            <p class="t-micro">{c.home.s7.label}</p>
            <h2 class="t-h1">{c.home.s7.h2}</h2>
          </div>
        </div>
      </section>
    </div>
  </div>

  <section class="screen screen--s8" data-screen="contact" data-dur="100" id="contact" data-theme="black">
    <div class="screen__pin">
      <div class="container stub">
        <p class="t-micro">{c.home.s8.label}</p>
        <h2 class="t-h1">{c.home.s8.h2}</h2>
        <p class="t-lead">{c.home.s8.lead}</p>
      </div>
    </div>
  </section>

  <script>
    import { initHome } from '../../lib/home';
    initHome();
  </script>
</Base>

<style>
  .stub {
    height: 100%;
    display: grid;
    align-content: center;
    gap: var(--space-4);
    max-width: 900px;
    margin-inline: 0;
    padding-top: var(--header-h);
  }
</style>
