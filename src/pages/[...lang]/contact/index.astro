---
/** /contact/ — форма, WhatsApp, каналы, география. */
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import LeadForm from '../../../components/LeadForm.astro';
import { getContent, langStaticPaths, localePath, formatAddress } from '../../../lib/i18n';
import { breadcrumbLd, telegramUrl } from '../../../lib/seo';
import { WHATSAPP_NUMBER, WHATSAPP_URL, GEOGRAPHY, ORG, SITE_NAME, SITE_LEGAL_NAME } from '../../../../site.config';

export function getStaticPaths() {
  return langStaticPaths();
}
const { lang } = Astro.props;
const c = getContent(lang);
const k = c.contact;
const crumbs = [
  { name: c.ui.home, path: '/' },
  { name: k.title, path: '/contact/' },
];
const jsonLd = [breadcrumbLd(lang, crumbs)];
// BRIEF-SEO §4: NAP (название, адрес, телефон) в том же формате, что в профиле компании; пустое не выводится
const address = formatAddress(lang, ORG.address);
const tel = `tel:+${WHATSAPP_NUMBER.replace(/\D/g, '')}`;
---

<Base lang={lang} path="/contact/" title={c.ui.meta.contact.title} description={c.ui.meta.contact.description} theme="ivory" jsonLd={jsonLd}>
  <PageHero theme="ivory" label={`${k.title} · 07`} title={k.h1} lead={k.lead} render="/posters/dir-contact.webp" beam={0.4} size="md" crumbs={crumbs.map((x) => ({ name: x.name, href: localePath(lang, x.path) }))} ariaCrumbs={c.ui.crumbs} />

  <section class="contact">
    <div class="container contact__inner">
      <div class="contact__form">
        <LeadForm lang={lang} id="lead-page" serviceSelect />
      </div>
      <aside class="contact__aside">
        <div class="channel">
          <p class="t-micro">{k.whatsappLabel}</p>
          <a class="channel__value" href={WHATSAPP_URL} target="_blank" rel="noopener">{WHATSAPP_NUMBER}</a>
        </div>
        {/* BRIEF-SEO §3–4: каналы и реквизиты — из ORG (site.config.ts); незаполненные не выводим */}
        {ORG.email && (
          <div class="channel">
            <p class="t-micro">{k.emailLabel}</p>
            <a class="channel__value" href={`mailto:${ORG.email}`}>{ORG.email}</a>
          </div>
        )}
        {ORG.telegram && (
          <div class="channel">
            <p class="t-micro">{k.telegramLabel}</p>
            <a class="channel__value" href={telegramUrl(ORG.telegram)} target="_blank" rel="noopener">{ORG.telegram.replace(/^https?:\/\/t\.me\//, '@')}</a>
          </div>
        )}
        <address class="channel nap">
          <p class="t-micro">{k.napTitle}</p>
          <p class="nap__name">{SITE_NAME} · {SITE_LEGAL_NAME}</p>
          {address && <p class="t-small">{address}</p>}
          <p class="t-small"><span class="nap__k">{k.phoneLabel}:</span> <a href={tel}>{WHATSAPP_NUMBER}</a></p>
          {ORG.vatId && <p class="t-small"><span class="nap__k">{k.vatLabel}:</span> {ORG.vatId}</p>}
        </address>
        <div class="channel">
          <p class="t-micro">{k.geoTitle}</p>
          <p class="t-small">{GEOGRAPHY.join(' · ')}</p>
        </div>
      </aside>
    </div>
  </section>

  <script>
    import { initForms } from '../../../lib/form';
    initForms();
  </script>
</Base>

<style>
  .contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-12);
    padding-top: var(--section-pad);
    padding-bottom: var(--section-pad);
    max-width: none;
  }
  .contact__aside {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }
  .channel {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hair);
  }
  .nap {
    font-style: normal;
  }
  .nap__name {
    font-size: 1.0625rem;
  }
  .nap__k {
    color: var(--fg-3);
  }
  .nap a:hover {
    color: var(--accent);
  }
  .channel__value {
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    letter-spacing: 0.02em;
  }
  .channel__value--ph {
    color: var(--fg-3);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
  }
  @media (max-width: 899px) {
    .contact__inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
