---
/**
 * Логотип сайта. Активный вариант — src/assets/logo/logo.svg (и logo-mark.svg).
 * Смена варианта: python scripts/build-logo.py --active a|b|c (см. REPORT.md).
 */
import logoSvg from '../assets/logo/logo.svg?raw';
import markSvg from '../assets/logo/logo-mark.svg?raw';

export interface Props {
  compact?: boolean;
  class?: string;
  height?: number;
}
// height не задан — высоту даёт CSS-переменная --logo-h контейнера (шапка: 40 / 34 px, BRIEF-7 §6)
const { compact = false, class: cls = '', height } = Astro.props;
const svg = compact ? markSvg : logoSvg;
---

<span class:list={['logo', cls, { 'logo--mark': compact }]} style={height ? `--logo-h:${height}px` : undefined} set:html={svg} />

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    height: var(--logo-h, 28px);
    color: var(--fg);
    --logo-accent: var(--accent);
  }
  .logo :global(svg) {
    height: 100%;
    width: auto;
    display: block;
  }
</style>
