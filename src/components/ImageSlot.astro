---
/**
 * Фотослот (BRIEF-2 §7, BRIEF-4 §3 / MEDIA-INTEGRATION §2). Значение слота в `src/content/media.json` —
 * строка (путь относительно `src/assets/`) или объект `{ src, mono, kind, hover, brand, alt }`:
 *   kind  — logo | avatar | photo | monogram | render (на вёрстку не влияет, кроме render: без кейлайна, cover 50% 45%)
 *   hover — "lift": подъём 1.025 + осветление soft-light + тень (десктоп по наведению, тач — по центру экрана);
 *           "none": плитка статична (команда, «О компании», направления).
 * Если файла нет — процедурный плейсхолдер «свет на бетоне» из public/placeholders/, вариант по id.
 */
import { Image } from 'astro:assets';
import media from '../content/media.json';
import { withBase } from '../lib/base';

export interface Props {
  id: string;
  ratio?: '3:4' | '4:5' | '1:1' | '4:3' | '16:9';
  alt?: string;
  sizes?: string;
  class?: string;
  /** приоритетная загрузка (первый экран) */
  eager?: boolean;
}
const { id, ratio = '4:5', alt = '', sizes = '(max-width: 899px) 100vw, 50vw', class: cls = '', eager = false } = Astro.props;

interface SlotEntry {
  src: string;
  mono?: string | null;
  kind?: 'logo' | 'avatar' | 'photo' | 'monogram' | 'render';
  hover?: 'lift' | 'none';
  brand?: string | null;
  alt?: string;
}
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/media/**/*.{jpg,jpeg,png,webp,avif}');
const raw = (media as Record<string, string | SlotEntry | null>)[id] ?? null;
const entry: SlotEntry | null = typeof raw === 'string' ? { src: raw } : raw;
let image: ImageMetadata | null = null;
if (entry?.src) {
  const key = `/src/assets/${entry.src.replace(/^\/?(src\/assets\/)?/, '')}`;
  const loader = files[key];
  if (!loader) throw new Error(`media.json: файл ${key} для слота «${id}» не найден в src/assets/media/`);
  image = (await loader()).default;
}
const kind = entry?.kind ?? 'photo';
const lift = entry?.hover === 'lift';
const altText = alt || entry?.alt || '';
const [rw, rh] = ratio.split(':').map(Number);
// вариант плейсхолдера по id — устойчивый хэш, чтобы соседние слоты отличались
let h = 0;
for (let i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) >>> 0;
const variant = (h % 6) + 1;
const widths = [480, 800, 1200, 1600].filter((w) => !image || w <= image.width);
---

<figure
  class:list={['slot', cls, { 'slot--ph': !image, 'slot--lift': lift, 'slot--render': kind === 'render' }]}
  style={`--ratio:${rw}/${rh}`}
  data-slot={id}
  data-kind={kind}
  data-lift={lift ? '' : undefined}
>
  {image ? (
    <Image src={image} alt={altText} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} decoding="async" class="slot__img" />
  ) : (
    <span class="slot__ph" style={`background-image:url(${withBase(`/placeholders/ph-${variant}.webp`)})`} role={altText ? 'img' : undefined} aria-label={altText || undefined}>
      {import.meta.env.DEV && <span class="slot__dev t-micro">ФОТО · {ratio}</span>}
    </span>
  )}
  {lift && <span class="slot__wash" aria-hidden="true"></span>}
</figure>

<style>
  .slot {
    position: relative;
    margin: 0;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--stone);
  }
  .slot__img,
  .slot__ph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .slot__img {
    object-fit: cover;
  }
  /* рендер сферы — не фото: кадрируем по центру чуть выше середины, без кейлайна и меток */
  .slot--render .slot__img {
    object-fit: cover;
    object-position: 50% 45%;
  }
  .slot--render {
    background: var(--bg);
  }
  .slot__ph {
    background-size: cover;
    background-position: center;
  }
  .slot__dev {
    position: absolute;
    right: 10px;
    bottom: 8px;
    color: var(--bark);
    opacity: 0.7;
  }
  /* MEDIA-INTEGRATION §2: спокойный подъём плитки — масштаб, лёгкое осветление, мягкая тень */
  .slot--lift {
    transition: transform 1.4s var(--ease-out), box-shadow 0.7s var(--ease-out);
    will-change: transform;
  }
  .slot__wash {
    position: absolute;
    inset: 0;
    background: var(--paper);
    mix-blend-mode: soft-light;
    opacity: 0;
    transition: opacity 0.7s var(--ease-out);
    pointer-events: none;
  }
  :global(a:hover) > .slot--lift,
  :global(a:focus-visible) > .slot--lift,
  :global(.is-lifted) .slot--lift,
  .slot--lift.is-lifted {
    transform: scale(1.025);
    box-shadow: 0 18px 40px -24px rgba(27, 26, 24, 0.35);
  }
  :global(a:hover) > .slot--lift .slot__wash,
  :global(a:focus-visible) > .slot--lift .slot__wash,
  :global(.is-lifted) .slot--lift .slot__wash,
  .slot--lift.is-lifted .slot__wash {
    opacity: 0.55;
  }
  @media (prefers-reduced-motion: reduce) {
    .slot--lift,
    .slot__wash {
      transition: none;
    }
    :global(a:hover) > .slot--lift,
    :global(.is-lifted) .slot--lift,
    .slot--lift.is-lifted {
      transform: none;
      box-shadow: none;
    }
  }
</style>
