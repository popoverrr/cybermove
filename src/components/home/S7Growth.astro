---
/** S7 · РОСТ — GROWTH. Счётчики, горизонтальная лента избранных кейсов внутри pin, кнопка «Все кейсы», тикер. */
import Button from '../Button.astro';
import CaseFrame from '../CaseFrame.astro';
import { getContent, localePath, findCase, type LangCode } from '../../lib/i18n';
import { TICKER } from '../../../site.config';

export interface Props {
  lang: LangCode;
}
const { lang } = Astro.props;
const c = getContent(lang);
const s7 = c.home.s7;
const h2 = s7.h2;
const featured = s7.featured.map((id) => findCase(c, id)).filter(Boolean) as NonNullable<ReturnType<typeof findCase>>[];
/** id фотослотов избранных кейсов (media.json) */
const SLOT: Record<string, string> = { usyk: 'case-usyk', 'ukrainian-fashion-week': 'case-ufw', intertop: 'case-intertop', 'brsm-nafta': 'case-brsm', 'hydrosta-kazakhstan': 'case-hydrosta' };
const tickerItems = [...TICKER, ...TICKER];
---

<section class="screen screen--s7" data-screen="growth" data-dur="220" data-dur-mobile="180" id="growth" data-theme="ivory" aria-labelledby="h-growth">
  <div class="screen__pin">
    <div class="g container" data-growth>
      <p class="g__corner g__corner--tr t-micro" data-tw>GROWTH · RINGS · {c.home.s7.counters[0].value}+</p>
      <div class="g__head" data-tw>
        <p class="t-micro g__label">{s7.label}</p>
        <h2 class="t-h1 g__h2" id="h-growth" set:html={h2} />
      </div>

      <ul class="counters" data-counters data-tw>
        {s7.counters.map((k) => (
          <li class="counter">
            <p class="counter__value t-counter"><span data-count={k.value}>0</span>{k.suffix}</p>
            <p class="counter__label t-micro">{k.label}</p>
          </li>
        ))}
      </ul>

      <div class="ribbon-wrap" data-tw>
        <div class="ribbon" data-ribbon>
          {featured.map((k, i) => (
            <a class="card" href={localePath(lang, `/cases/${k.id}/`)}>
              {/* BRIEF-5 §4: имя и логотип — на кадре; отдельной строкой ниже их не повторяем */}
              <CaseFrame id={SLOT[k.id] ?? `case-${k.id}`} name={k.name} ratio="4:5" sizes="(max-width: 899px) 72vw, 22vw" class="card__photo" />
              <span class="card__idx t-micro">0{i + 1} / 0{featured.length}</span>
              <span class="card__sum t-small">{k.summary}</span>
              <span class="card__tags t-micro">{k.tags.join(' · ')}</span>
              <span class="card__result t-micro">{s7.resultsPlaceholder}</span>
            </a>
          ))}
          <a class="card card--more" href={localePath(lang, '/cases/')}>
            <span class="card__name t-h4">{s7.cta} →</span>
            <span class="card__sum t-small">{c.cases.h1}</span>
          </a>
        </div>
      </div>

      <div class="g__foot" data-tw>
        <Button href={localePath(lang, '/cases/')} variant="ghost" arrow>{s7.cta}</Button>
      </div>
    </div>

    <div class="g__ticker" aria-hidden="true">
      <div class="ticker">
        <div class="ticker__track ticker__track--rev">
          {tickerItems.map((t) => <span class="ticker__item t-micro">{t}</span>)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .g {
    position: relative;
    height: 100%;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    align-content: start;
    padding-top: calc(var(--header-h) + var(--space-6));
    padding-bottom: calc(var(--space-4) + 48px);
    max-width: none;
    row-gap: var(--space-3);
  }
  .g__corner {
    position: absolute;
    top: calc(var(--header-h) + var(--space-6));
    right: var(--gutter);
    margin: 0;
  }
  .g__head {
    display: grid;
    gap: var(--space-3);
    max-width: 56%;
  }
  .g__label {
    color: var(--accent);
  }
  .g__h2 {
    font-size: min(var(--fs-h1), 7.5vh);
  }
  /* BRIEF-4 §1.2: счётчики уже — сфера с кольцами живёт в правой трети и не ложится на цифры */
  .counters {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    max-width: 56%;
    border-top: 1px solid var(--hair);
    padding-top: var(--space-3);
  }
  .counter {
    display: grid;
    gap: var(--space-2);
  }
  .counter__value {
    font-size: min(var(--fs-counter), 7vh);
    color: var(--fg);
  }
  .counter__label {
    color: var(--fg-2);
  }
  .ribbon-wrap {
    align-self: end;
    overflow: hidden;
    margin-right: calc(var(--gutter) * -1);
    padding-right: var(--gutter);
    mask-image: linear-gradient(90deg, #000 0, #000 96%, transparent);
    -webkit-mask-image: linear-gradient(90deg, #000 0, #000 96%, transparent);
  }
  .ribbon {
    display: flex;
    gap: var(--space-4);
    width: max-content;
    will-change: transform;
  }
  .card {
    contain: paint;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    width: clamp(220px, 19vw, 260px);
    padding: var(--space-3);
    border: 1px solid var(--hair);
    background: var(--paper);
    transition: border-color var(--dur-fast), transform var(--dur) var(--ease-out);
  }
  .card :global(.card__photo) {
    margin: calc(var(--space-3) * -1) calc(var(--space-3) * -1) var(--space-2);
    aspect-ratio: auto;
    height: min(21vh, 200px);
  }
  .card__name {
    font-size: 1rem;
    line-height: 1.2;
  }
  .card__sum {
    font-size: 0.8rem;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card:hover {
    border-color: var(--hair-strong);
    transform: translateY(-4px);
  }
  .card__idx {
    color: var(--fg-3);
  }
  .card__sum {
    color: var(--fg-2);
  }
  .card__tags {
    color: var(--fg-3);
    margin-top: auto;
  }
  .card__result {
    color: var(--fg-3);
  }
  .card--more {
    justify-content: center;
    align-content: center;
    border-color: var(--hair-strong);
    background: transparent;
  }
  .g__foot {
    display: flex;
    justify-content: flex-start;
  }
  @media (max-height: 820px) and (min-width: 900px) {
    .g__foot {
      display: none;
    }
  }
  /*
   * Короткий экран (в том числе десктоп 1280×720): треки по содержимому, лента сверху своего трека.
   * Трек 1fr при `overflow: hidden` у ленты схлопывался, и `align-self: end` клал карточки на счётчики.
   */
  @media (max-height: 820px) {
    .g {
      grid-template-rows: auto auto auto auto;
    }
    .ribbon-wrap {
      align-self: start;
      min-height: 0;
    }
  }
  /* тикер поверх ленты: своя бумага, чтобы карточки не просвечивали под ним (BRIEF-4 §1.1) */
  .g__ticker {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: 48px;
    background: var(--paper);
    border-top: 1px solid var(--hair);
    padding-inline: var(--gutter);
    padding-left: calc(var(--gutter) + var(--rail-offset, 0px));
    display: flex;
    align-items: center;
  }
  .ticker {
    overflow: hidden;
    width: 100%;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .ticker__track {
    display: flex;
    gap: var(--space-12);
    width: max-content;
    animation: ticker-rev 56s linear infinite;
  }
  .ticker__item {
    white-space: nowrap;
    color: var(--fg-2);
  }
  @keyframes ticker-rev {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker__track {
      animation: none;
    }
  }
  @media (max-width: 899px) {
    /*
     * BRIEF-4 §1.1: четыре ряда по содержимому. Раньше третий трек был 1fr, а `.ribbon-wrap` с overflow: hidden
     * имеет нулевой минимальный размер — на короткой высоте (iPhone с панелями ≈ 660 px) трек схлопывался,
     * `align-self: end` поднимал ленту на счётчики. Переполнение решает сдвиг `.g` по прогрессу (home-extra.ts).
     */
    .g {
      grid-template-rows: auto auto auto auto;
      padding-top: calc(var(--header-h) + 10vh);
      row-gap: var(--space-3);
      padding-bottom: calc(var(--space-4) + 40px);
      overflow: hidden;
      will-change: transform;
    }
    .ribbon-wrap {
      align-self: start;
      min-height: 0;
    }
    .g__corner {
      display: none;
    }
    .g__head {
      max-width: 100%;
    }
    .g__h2 {
      font-size: clamp(1.6rem, 6.6vw, 2.2rem);
    }
    /*
     * На телефоне сцена (шар и кольца) проходит за счётчиками: полоса бумаги во всю ширину не даёт
     * шару лечь на цифры, как на скриншоте заказчика (docs/review/01), и держит ритм карточек.
     */
    .counters {
      max-width: 100%;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-2);
      background: var(--paper);
      margin-inline: calc(var(--gutter) * -1);
      padding: var(--space-3) var(--gutter);
      border-top: 1px solid var(--hair);
      border-bottom: 1px solid var(--hair);
    }
    .counter__value {
      font-size: clamp(1.6rem, 6.4vw, 2rem);
    }
    .card {
      width: 58vw;
      padding: var(--space-3);
      gap: 0.3rem;
    }
    .card :global(.card__photo) {
      height: min(14vh, 120px);
    }
    .card__name {
      font-size: 0.95rem;
    }
    .card__sum {
      font-size: 0.75rem;
    }
    .card__result {
      display: none;
    }
    .g__foot {
      display: none;
    }
    .g__ticker {
      height: 40px;
    }
  }
  /* на высоких телефонах место под лентой есть — карточка крупнее, пустоты внизу нет */
  @media (max-width: 899px) and (min-height: 780px) {
    .card :global(.card__photo) {
      height: min(22vh, 190px);
    }
  }
</style>
